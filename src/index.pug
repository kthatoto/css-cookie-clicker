- const click_limit = 100
- const item_rates = [1, 10, 100, 1000]
- const item_count = item_rates.length
- const combo_name = (flags) => flags.join("")
- const combo_rate = (flags) => 1 + flags.reduce((sum, flag, index) => sum + (flag ? item_rates[index] : 0), 0)
- const combos = Array.from({ length: Math.pow(2, item_count) }, (_, mask) => Array.from({ length: item_count }, (_, index) => (mask >> (item_count - 1 - index)) & 1))

mixin click-group(flags)
  - const rate = combo_rate(flags)
  .click-group(class="combo-" + combo_name(flags) data-rate=rate)
    each _, index in Array(click_limit)
      input.increment(
        type="checkbox"
        aria-label=rate + (rate === 1 ? " cookie" : " cookies") + " per click: " + (index + 1)
      )

mixin shop-item(index)
  div(class="item" + index)
    span
    .purchase
      input.item(
        id="item" + index
        type="checkbox"
        aria-label="アイテム" + index + "を購入"
      )
      span 購入

doctype html
html(lang="ja")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="./style.css")
  body
    h1 CSS Cookie Clicker
    #main
      span#cookie 🍪

      each flags in combos
        +click-group(flags)

      #shop
        div ショップ
        #items
          each _, index in Array(item_count)
            +shop-item(index + 1)
      #game-clear クリア🎉
    #result

- const click_limit = 100
- const item_count = 4
- const click_rates = Array.from({ length: item_count + 1 }, (_, index) => index + 1)

mixin click-group(rate)
  .click-group(class="rate-" + rate data-rate=rate)
    each _, index in Array(click_limit)
      input.increment(
        type="checkbox"
        aria-label=rate + " cookie per click: " + (index + 1)
      )

mixin shop-item(index)
  div(class="item" + index)
    span
    .purchase
      input.item(
        id="item" + index
        type="checkbox"
        aria-label="アイテム" + index + "を購入"
      )
      span 購入

html
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="./style.css")
  body
    h1 CSS Cookie Clicker
    #main
      span#cookie 🍪

      each rate in click_rates
        +click-group(rate)

      #shop
        div ショップ
        #items
          each _, index in Array(item_count)
            +shop-item(index + 1)
      #game-clear クリア🎉
    #result
